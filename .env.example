# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave blank to use SQLite for local dev)
# Recommended (Docker Compose): postgres://sums_user:sums_password@db:5432/sums_db
# Recommended (local Postgres): postgres://sums_user:sums_password@localhost:5432/sums_db
DATABASE_URL=postgresql://sums_user:sums_password@db:5432/sums_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Cloudinary (optional for local dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Integration (optional - used for real AI features)
OPENAI_API_KEY=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@sums.edu
