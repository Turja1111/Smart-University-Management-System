# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL — use ONE of: DATABASE_URL (recommended for cloud) OR discrete variables below.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Railway can also provide PGDATABASE, PGUSER, PGPASSWORD, PGHOST, and PGPORT.
DB_NAME=sums
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# Optional: persistent connections (seconds); 0 to disable
# DB_CONN_MAX_AGE=600
# DB_CONNECT_TIMEOUT=10

# Redis (optional; omit to run Celery tasks inline)
REDIS_URL=

# Cloudinary (optional for local dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Integration (optional - used for real AI features)
OPENAI_API_KEY=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@sums.edu
